#!/bin/bash

# env-base: shared setup/teardown for TCP test environments.
#
# Source this AFTER setting the following variables:
#   NETEM_PORT    - HTTP server port (e.g. 8001)
#   NETEM_CLASSID - HTB class ID (e.g. "1:1"), empty to skip tc setup
#   NETEM_QDISC   - netem parameters (e.g. "delay 2000ms"), empty to skip tc setup

set -eu

source "$(dirname $0)/../../utils/common"

# Normalize volatile HTTP response headers so diff against fixture is stable.
function strip_http_header {
    sed 's/^Date:.*/Date:/' | sed 's/^Server:.*/Server:/'
}

# Build an HTB (Hierarchical Token Bucket) tree on tap0:
#   root qdisc (handle 1:, added by test-run-all)
#     -> class 1:$NETEM_CLASSID
#        -> netem qdisc with $NETEM_QDISC
# tc filter routes traffic matching $NETEM_PORT into the class.
function tc_base_setup {
    if [[ -n "${NETEM_QDISC:-}" ]] && [[ -n "${NETEM_CLASSID:-}" ]]; then
        tc class add dev tap0 parent 1: classid "$NETEM_CLASSID" htb rate 100mbit
        tc filter add dev tap0 parent 1: protocol ip prio 1 u32 \
            flowid "$NETEM_CLASSID" match ip sport "$NETEM_PORT" 0xffff
        tc filter add dev tap0 parent 1: protocol ip prio 1 u32 \
            flowid "$NETEM_CLASSID" match ip dport "$NETEM_PORT" 0xffff
        tc qdisc add dev tap0 parent "$NETEM_CLASSID" netem $NETEM_QDISC
    fi
}

function tc_base_teardown {
    if [[ -n "${NETEM_CLASSID:-}" ]]; then
        tc qdisc del dev tap0 parent "$NETEM_CLASSID" 2>/dev/null || true
        tc filter del dev tap0 parent 1: protocol ip prio 1 2>/dev/null || true
        tc class del dev tap0 parent 1: classid "$NETEM_CLASSID" 2>/dev/null || true
    fi
}

function setup {
    python3 -m http.server "$NETEM_PORT" >/dev/null 2>&1 &
    httpserver="$!"

    tc_base_setup

    sleep 5

    if ! kill -0 "$httpserver" 2>/dev/null; then
        echo "ERROR: HTTP server failed to start on port $NETEM_PORT" >&2
        exit 1
    fi
}

function teardown_suite {
    if [[ -n "${httpserver:-}" ]]; then
        kill "$httpserver" 2>/dev/null || true
    fi
    tc_base_teardown
}

trap teardown_suite EXIT ERR
setup
