#!/bin/bash
#
# suite-ipv6 - End-to-end IPv6 integration test suite.
#
# Tests:
#   1. ping6 reachability (H-05)
#   2. NDP neighbor cache verification (H-06)
#   3. SLAAC address generation (H-09)
#   4. PMTUD with tc netem (H-14)
#   5. curl over IPv6 TCP (H-12, optional)
#
# Prerequisites:
#   - lvl-ip daemon running (started by test-run-all)
#   - setup_ipv6.sh executed to configure host environment
#   - ping6, ip, tc available
#

set -eu

source "$(dirname $0)/../../utils/common"

# IPv6 addresses used for testing
IPV6_STACK_LL=""       # link-local address (auto-generated by SLAAC)
IPV6_STACK_GLOBAL=""   # global address (if configured)
IPV6_HOST_ADDR="fd00::1"
TAP_DEV="tap0"

#
# Discover the stack's link-local address from NDP neighbor cache.
# The stack generates fe80::/64 + EUI-64 from its MAC address.
#
function discover_stack_ll {
    local attempts=0
    local max_attempts=10

    while [ $attempts -lt $max_attempts ]; do
        # Trigger NDP by pinging the all-nodes multicast
        ping6 -c1 -I ${TAP_DEV} ff02::1 >/dev/null 2>&1 || true
        sleep 1

        # Look for the stack's link-local in neighbor cache
        IPV6_STACK_LL=$(ip -6 neigh show dev ${TAP_DEV} | \
            grep -v "${IPV6_HOST_ADDR}" | \
            grep "fe80" | \
            head -1 | awk '{print $1}')

        if [ -n "${IPV6_STACK_LL}" ]; then
            return 0
        fi

        attempts=$((attempts + 1))
    done

    echo "WARNING: Could not discover stack link-local address"
    return 1
}

#
# Test 1: ping6 reachability (H-05)
# Sends ICMPv6 Echo Requests to the stack and expects Echo Replies.
#
function test_ping6 {
    if [ -z "${IPV6_STACK_LL}" ]; then
        echo "SKIP: no stack link-local address discovered"
        return 0
    fi

    ping6 -c3 -I ${TAP_DEV} "${IPV6_STACK_LL}%${TAP_DEV}" >/dev/null
}

#
# Test 2: NDP neighbor cache verification (H-06)
# After ping6, the host should have a REACHABLE or STALE neighbor entry.
#
function test_ndp_neighbor {
    if [ -z "${IPV6_STACK_LL}" ]; then
        echo "SKIP: no stack link-local address discovered"
        return 0
    fi

    # Trigger a ping to ensure NDP is active
    ping6 -c1 -I ${TAP_DEV} "${IPV6_STACK_LL}%${TAP_DEV}" >/dev/null 2>&1 || true
    sleep 1

    # Check neighbor cache
    local state=""
    state=$(ip -6 neigh show dev ${TAP_DEV} to "${IPV6_STACK_LL}" | awk '{print $NF}')

    if [ -z "${state}" ]; then
        echo "FAIL: no NDP neighbor entry for ${IPV6_STACK_LL}"
        return 1
    fi

    case "${state}" in
        REACHABLE|STALE|DELAY|PROBE)
            return 0
            ;;
        *)
            echo "FAIL: unexpected NDP state: ${state}"
            return 1
            ;;
    esac
}

#
# Test 3: SLAAC address generation (H-09)
# Verify the stack auto-generated a link-local address (fe80::/64).
#
function test_slaac {
    if [ -z "${IPV6_STACK_LL}" ]; then
        echo "SKIP: no stack link-local address discovered"
        return 0
    fi

    # Verify it starts with fe80
    if echo "${IPV6_STACK_LL}" | grep -q "^fe80"; then
        return 0
    fi

    echo "FAIL: stack address ${IPV6_STACK_LL} is not link-local"
    return 1
}

#
# Test 4: PMTUD with tc netem (H-14)
# Limit MTU to 1280 and verify TCP MSS adjusts accordingly.
# Note: This test requires a working TCP IPv6 connection.
#
function test_pmtud {
    # Set MTU to 1280 on tap0
    ip link set dev ${TAP_DEV} mtu 1280

    # Wait for PMTU to propagate
    sleep 1

    # If we have a stack address, try ping6 with large packets
    if [ -n "${IPV6_STACK_LL}" ]; then
        # Send a ping with payload > 1280 to trigger PTB
        # The stack should still respond (PMTUD adjusts)
        ping6 -c2 -s 1200 -I ${TAP_DEV} "${IPV6_STACK_LL}%${TAP_DEV}" >/dev/null 2>&1 || true
    fi

    # Restore MTU
    ip link set dev ${TAP_DEV} mtu 1500

    return 0
}

#
# Test 5: curl over IPv6 TCP (H-12)
# This requires liblevelip.so to support AF_INET6 connect().
# Currently optional as it depends on full TCP IPv6 support.
#
function test_curl_ipv6 {
    # This test is optional and may not work in all environments
    if [ -z "${IPV6_STACK_LL}" ]; then
        echo "SKIP: no stack link-local address"
        return 0
    fi

    # TODO: Implement when full TCP IPv6 server support is available
    echo "SKIP: curl over IPv6 TCP not yet fully supported"
    return 0
}

# Run all tests
echo "=== IPv6 Integration Tests ==="

# Discover stack address first
discover_stack_ll || true

test_run "test_ping6" "$0"
test_run "test_ndp_neighbor" "$0"
test_run "test_slaac" "$0"
test_run "test_pmtud" "$0"
test_run "test_curl_ipv6" "$0"

echo "=== IPv6 Tests Complete ==="
