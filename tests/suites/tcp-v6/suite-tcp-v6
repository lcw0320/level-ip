#!/bin/bash
#
# suite-tcp-v6 — TCP over IPv6 end-to-end test suite (TDD red phase).
#
# Tests:
#   1. TCP/IPv6 client connect (stack → host HTTP server)
#   2. TCP/IPv6 client getpeername (verify AF_INET6)
#   3. TCP/IPv6 server accept  (host → stack echo server)
#   4. TCP/IPv6 server echo data integrity
#
# Prerequisites:
#   - lvl-ip daemon running (started by test-run-all)
#   - curl-v6 and tcp-v6-server apps built (make apps)
#   - python3, nc (netcat) available on host
#
# Expected result (red phase): ALL tests should FAIL,
# exposing TCP/IPv6 bugs in accept(), getpeername(), etc.
#

set -eu

source "$(dirname $0)/../../utils/common"

TAP_DEV="tap0"
IPV6_HOST_LL="fe80::1"
HTTP_PORT=8080
NC_PORT=8081
ECHO_PORT=9090
ECHO_PORT2=9091
STACK_LL=""

HTTP_PID=""
NC_PID=""
SERVER_PID=""
SERVER_LOG=""

# ── helpers ──────────────────────────────────────────────

function ensure_host_ll_addr {
    # Ensure the host has fe80::1/64 on tap0 for link-local TCP tests.
    # Most Linux kernels auto-generate a different link-local, so we add
    # a known one explicitly.
    if ! ip -6 addr show dev "$TAP_DEV" 2>/dev/null | grep -q "${IPV6_HOST_LL}/"; then
        ip -6 addr add "${IPV6_HOST_LL}/64" dev "$TAP_DEV" 2>/dev/null || true
    fi
}

function discover_stack_ll {
    local attempts=0
    local max_attempts=10

    while [ $attempts -lt $max_attempts ]; do
        # Trigger NDP via all-nodes multicast ping
        ping6 -c1 -W1 -I "$TAP_DEV" ff02::1 >/dev/null 2>&1 || true
        sleep 1

        # Find the stack's link-local in the neighbor cache
        # (exclude our own fe80::1)
        STACK_LL=$(ip -6 neigh show dev "$TAP_DEV" 2>/dev/null | \
            grep "fe80" | grep -v "^${IPV6_HOST_LL} " | \
            head -1 | awk '{print $1}')

        if [ -n "$STACK_LL" ]; then
            return 0
        fi

        attempts=$((attempts + 1))
    done

    echo "WARNING: could not discover stack link-local address"
    return 1
}

function cleanup {
    # Kill any background processes we started
    [ -n "$HTTP_PID" ] && kill "$HTTP_PID" 2>/dev/null || true
    [ -n "$NC_PID" ]   && kill "$NC_PID" 2>/dev/null || true
    [ -n "$SERVER_PID" ] && kill "$SERVER_PID" 2>/dev/null || true

    # Clean up temp files
    [ -n "$SERVER_LOG" ] && rm -f "$SERVER_LOG" 2>/dev/null || true

    wait 2>/dev/null || true
}

trap cleanup EXIT ERR

# ── environment setup ────────────────────────────────────

ensure_host_ll_addr
discover_stack_ll || true

# ── Test 1: TCP/IPv6 client connect ──────────────────────
#
# Start an IPv6 HTTP server on the host, then use curl-v6
# through the stack to connect.  Verifies the TCP/IPv6
# three-way handshake + data exchange.
#
function test_tcp6_client_connect {
    local output=""

    # Start host-side IPv6 HTTP server
    python3 -m http.server "$HTTP_PORT" --bind "$IPV6_HOST_LL" >/dev/null 2>&1 &
    HTTP_PID=$!
    sleep 2

    # Run curl-v6 through the stack
    output=$("$repo/tools/level-ip" "$repo/apps/curl-v6/curl-v6" \
             "$IPV6_HOST_LL" "$HTTP_PORT" 2>&1) || true

    kill "$HTTP_PID" 2>/dev/null || true
    HTTP_PID=""

    # Check for HTTP response
    if echo "$output" | grep -q "HTTP/"; then
        echo "  OK: got HTTP response"
    else
        echo "  FAIL: no HTTP response. Output:"
        echo "$output" | head -5
        return 1
    fi
}

# ── Test 2: TCP/IPv6 client getpeername ──────────────────
#
# After a successful TCP/IPv6 connection, getpeername()
# should return AF_INET6, not AF_INET.
#
function test_tcp6_client_getpeername {
    local output=""

    # Start a simple TCP listener on the host
    nc -6 -l "$IPV6_HOST_LL" "$NC_PORT" >/dev/null 2>&1 &
    NC_PID=$!
    sleep 1

    # Run curl-v6 — it prints getpeername info before the HTTP request
    output=$("$repo/tools/level-ip" "$repo/apps/curl-v6/curl-v6" \
             "$IPV6_HOST_LL" "$NC_PORT" 2>&1) || true

    kill "$NC_PID" 2>/dev/null || true
    NC_PID=""

    # Verify getpeername returned AF_INET6
    if echo "$output" | grep -q "AF_INET6"; then
        echo "  OK: getpeername returned AF_INET6"
    else
        echo "  FAIL: getpeername did not return AF_INET6. Output:"
        echo "$output" | grep -i "peer\|family" || echo "$output" | head -3
        return 1
    fi
}

# ── Test 3: TCP/IPv6 server accept ───────────────────────
#
# Start the stack's echo server on IPv6, connect from host
# via nc.  Verifies bind/listen/accept and that accept()
# returns the correct AF_INET6 peer address.
#
function test_tcp6_server_accept {
    local server_output=""
    local nc_output=""

    if [ -z "$STACK_LL" ]; then
        echo "  SKIP: no stack link-local address"
        return 1
    fi

    SERVER_LOG=$(mktemp /tmp/tcp-v6-server.XXXXXX.log)

    # Start echo server inside the stack
    "$repo/tools/level-ip" "$repo/apps/tcp-v6-server/server" "$ECHO_PORT" \
        > "$SERVER_LOG" 2>&1 &
    SERVER_PID=$!

    # Wait for server to be listening
    local waited=0
    while [ $waited -lt 10 ]; do
        if grep -q "LISTENING" "$SERVER_LOG" 2>/dev/null; then
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    if ! grep -q "LISTENING" "$SERVER_LOG" 2>/dev/null; then
        echo "  FAIL: echo server did not start listening"
        cat "$SERVER_LOG" 2>/dev/null | head -5
        kill "$SERVER_PID" 2>/dev/null || true
        SERVER_PID=""
        return 1
    fi

    # Connect from host
    nc_output=$(echo "hello-ipv6-test" | \
        timeout 5 nc -6 "$STACK_LL" "$ECHO_PORT" 2>&1) || true

    sleep 2

    server_output=$(cat "$SERVER_LOG" 2>/dev/null)

    kill "$SERVER_PID" 2>/dev/null || true
    SERVER_PID=""

    # Check 1: nc received the echo
    if echo "$nc_output" | grep -q "hello-ipv6-test"; then
        echo "  OK: echo data received"
    else
        echo "  FAIL: nc did not receive echo. nc output: '$nc_output'"
        return 1
    fi

    # Check 2: server reported AF_INET6 peer
    if echo "$server_output" | grep -q "AF_INET6"; then
        echo "  OK: server reported AF_INET6 peer"
    else
        echo "  FAIL: server did not report AF_INET6 peer. Server output:"
        echo "$server_output" | grep -i "peer\|family\|accept" || echo "$server_output" | head -5
        return 1
    fi

    rm -f "$SERVER_LOG" 2>/dev/null || true
    SERVER_LOG=""
}

# ── Test 4: TCP/IPv6 server echo data integrity ──────────
#
# Send a larger payload (1 KB) through the echo server and
# verify data integrity via md5sum comparison.
#
function test_tcp6_server_echo_data {
    local server_output=""
    local send_file=""
    local recv_file=""
    local send_md5=""
    local recv_md5=""

    if [ -z "$STACK_LL" ]; then
        echo "  SKIP: no stack link-local address"
        return 1
    fi

    SERVER_LOG=$(mktemp /tmp/tcp-v6-server2.XXXXXX.log)
    send_file=$(mktemp /tmp/tcp-v6-send.XXXXXX)
    recv_file=$(mktemp /tmp/tcp-v6-recv.XXXXXX)

    # Generate 1KB test data
    dd if=/dev/urandom bs=1024 count=1 of="$send_file" 2>/dev/null

    # Start echo server inside the stack
    "$repo/tools/level-ip" "$repo/apps/tcp-v6-server/server" "$ECHO_PORT2" \
        > "$SERVER_LOG" 2>&1 &
    SERVER_PID=$!

    # Wait for server to be listening
    local waited=0
    while [ $waited -lt 10 ]; do
        if grep -q "LISTENING" "$SERVER_LOG" 2>/dev/null; then
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    if ! grep -q "LISTENING" "$SERVER_LOG" 2>/dev/null; then
        echo "  FAIL: echo server did not start listening"
        kill "$SERVER_PID" 2>/dev/null || true
        SERVER_PID=""
        rm -f "$send_file" "$recv_file" 2>/dev/null || true
        return 1
    fi

    # Send data and capture response
    timeout 10 nc -6 "$STACK_LL" "$ECHO_PORT2" < "$send_file" > "$recv_file" 2>/dev/null || true

    sleep 2

    kill "$SERVER_PID" 2>/dev/null || true
    SERVER_PID=""

    # Compare checksums
    send_md5=$(md5sum "$send_file" | awk '{print $1}')
    recv_md5=$(md5sum "$recv_file" | awk '{print $1}')

    if [ "$send_md5" = "$recv_md5" ] && [ -n "$send_md5" ]; then
        echo "  OK: data integrity verified (md5=$send_md5)"
    else
        echo "  FAIL: data mismatch. send=$send_md5 recv=$recv_md5"
        echo "  send_size=$(wc -c < "$send_file") recv_size=$(wc -c < "$recv_file")"
        rm -f "$send_file" "$recv_file" "$SERVER_LOG" 2>/dev/null || true
        SERVER_LOG=""
        return 1
    fi

    rm -f "$send_file" "$recv_file" "$SERVER_LOG" 2>/dev/null || true
    SERVER_LOG=""
}

# ── run tests ────────────────────────────────────────────

echo "=== TCP/IPv6 Integration Tests ==="
echo "  Stack LL: ${STACK_LL:-<not discovered>}"
echo "  Host LL:  ${IPV6_HOST_LL}"
echo ""

test_run "test_tcp6_client_connect" "$0"
test_run "test_tcp6_client_getpeername" "$0"
test_run "test_tcp6_server_accept" "$0"
test_run "test_tcp6_server_echo_data" "$0"

echo "=== TCP/IPv6 Tests Complete ==="
